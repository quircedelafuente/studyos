# Copia a .env.local (local) o configura en Vercel → Environment Variables.

AUTH_SECRET=
# Obligatorio en producción (Vercel). Debe ser la URL pública SIN barra final:
#   https://tu-proyecto.vercel.app
# En local:
#   http://localhost:3000
# Si AUTH_URL no coincide con la URL de la barra del navegador → Error 400 redirect_uri_mismatch
# Ajusta el puerto al de `npm run dev` (3000, 3001, …)
AUTH_URL=http://localhost:3001

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Depuración: abre en el navegador (mismo host/puerto que la app):
#   /api/debug/oauth-callback
# Te devuelve JSON con la redirectUri exacta que debes pegar en Google Cloud.

# Google Cloud → Credenciales OAuth → «URIs de redirección autorizadas»:
#   http://localhost:3000/api/auth/callback/google
#   http://127.0.0.1:3000/api/auth/callback/google   (si entras por 127.0.0.1)
#   https://TU-PROYECTO.vercel.app/api/auth/callback/google
#
# «Orígenes JavaScript autorizados»:
#   http://localhost:3000
#   https://TU-PROYECTO.vercel.app

# Blackboard Learn (panel Assignments)
# URL base por defecto en el formulario:
# NEXT_PUBLIC_BLACKBOARD_BASE_URL=https://blackboard.ie.edu
# ID de la extensión «extensions/blackboard-bridge» (chrome://extensions → ID).
# En Vercel (producción) conviene definirlo aquí: la sync en la nube puede no traer
# el ID guardado en el navegador. Tras añadirlo, redeploy. La extensión v1.0.1+
# incluye https://*.vercel.app en externally_connectable (recarga la extensión en Chrome).
# NEXT_PUBLIC_BB_BRIDGE_EXTENSION_ID=

# Sincronización en la nube (Neon Postgres). Sin esto, la app funciona solo en localStorage.
# Cadena «Connection string» del proyecto Neon (modo pooled recomendado para serverless).
DATABASE_URL=

# Backend NotebookLM (FastAPI). En local: http://127.0.0.1:8000
# En producción: URL pública de Railway u otro host (https://… sin barra final).
NOTEBOOKLM_BACKEND_URL=http://127.0.0.1:8000

# ─── Solo en Railway (servicio Python backend), NO en Vercel ───
# Sesión Playwright exportada tras `npm run notebooklm:login` → contenido de
# ~/.notebooklm/storage_state.json (JSON completo, una línea con jq -c).
# NOTEBOOKLM_AUTH_JSON={"cookies":[...]}

# Study Planner — OpenRouter (por defecto: Google Gemini 2.5 Flash)
# Clave en https://openrouter.ai/keys — nunca commitees la clave; usa solo .env.local
OPENROUTER_API_KEY=
# Opcional. Por defecto: google/gemini-2.5-flash
# OPENROUTER_MODEL=google/gemini-2.5-flash-preview-09-2025
# Opcional: URL para cabecera HTTP-Referer (OpenRouter)
# OPENROUTER_HTTP_REFERER=https://tu-dominio.com

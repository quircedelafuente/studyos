{
  "name": "iestudio",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/agustmun-web/studyos.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "notebooklm:backend": "cd backend && .venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000",
    "notebooklm:login": "PLAYWRIGHT_BROWSERS_PATH=$HOME/Library/Caches/ms-playwright notebooklm login",
    "notebooklm:auth": "notebooklm auth check --test",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "bash scripts/vercel-deploy.sh",
    "cap:sync": "bash scripts/cap-sync-ios.sh",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@neondatabase/serverless": "^1.0.2",
    "@types/react-grid-layout": "^1.3.6",
    "archiver": "^7.0.1",
    "cheerio": "^1.2.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.44",
    "luxon": "^3.7.2",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "^2.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
